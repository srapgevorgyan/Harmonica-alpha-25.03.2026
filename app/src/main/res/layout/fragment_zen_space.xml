<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/harmonica_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtZenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Zen Space"
        android:textColor="@color/harmonica_primary"
        android:textSize="28sp"
        android:textStyle="italic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtZenSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Take a moment for yourself."
        android:textColor="@color/harmonica_hint"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtZenTitle" />

    <!-- 1. Selection UI -->
    <ScrollView
        android:id="@+id/layoutSelection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnEndZen"
        app:layout_constraintTop_toBottomOf="@id/txtZenSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPMR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muscle Relaxation"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/harmonica_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tense and release muscles to drop physical anxiety."
                        android:textSize="13sp"
                        android:textColor="@color/harmonica_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBilateral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bilateral Stimulation"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/harmonica_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="EMDR-style focus for panic and anxiety relief."
                        android:textSize="13sp"
                        android:textColor="@color/harmonica_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBreathing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guided Breathing"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/harmonica_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Regulate your heart rate with a 4-4-4 cycle."
                        android:textSize="13sp"
                        android:textColor="@color/harmonica_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGrounding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Grounding"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/harmonica_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Name your surroundings aloud to re-center."
                        android:textSize="13sp"
                        android:textColor="@color/harmonica_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGratitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Gratitude"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/harmonica_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Shift focus to the positive things in your life."
                        android:textSize="13sp"
                        android:textColor="@color/harmonica_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- 2. Breathing Container -->
    <LinearLayout
        android:id="@+id/layoutBreathing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnEndZen"
        app:layout_constraintTop_toBottomOf="@id/txtZenSubtitle">

        <View
            android:id="@+id/viewBreathingCircle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_circle_breathing" />

        <TextView
            android:id="@+id/txtBreathAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="serif"
            android:text="Inhale..."
            android:textColor="@color/harmonica_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Grounding Container -->
    <LinearLayout
        android:id="@+id/layoutGrounding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnEndZen"
        app:layout_constraintTop_toBottomOf="@id/txtZenSubtitle">

        <TextView
            android:id="@+id/txtGroundingPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hold the mic and name 5 things you can SEE."
            android:textColor="@color/harmonica_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroundingList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp" />
            
        <TextView
            android:id="@+id/txtLiveTranscription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="..."
            android:textColor="@color/harmonica_hint"
            android:textSize="16sp"
            android:textStyle="italic"
            android:gravity="center" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            app:backgroundTint="@color/harmonica_primary"
            app:srcCompat="@android:drawable/ic_btn_speak_now"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- 4. Gratitude Container -->
    <LinearLayout
        android:id="@+id/layoutGratitude"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnEndZen"
        app:layout_constraintTop_toBottomOf="@id/txtZenSubtitle">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What are 3 things you are grateful for right now?"
            android:textColor="@color/harmonica_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/editGratitude1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1. Something small..."
            android:padding="16dp"
            android:background="@drawable/bg_bubble_ai"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editGratitude2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2. Someone you appreciate..."
            android:padding="16dp"
            android:background="@drawable/bg_bubble_ai"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editGratitude3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3. An achievement or moment..."
            android:padding="16dp"
            android:background="@drawable/bg_bubble_ai"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSaveGratitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save to Heart"
            android:layout_marginTop="16dp"
            app:cornerRadius="28dp" />
    </LinearLayout>

    <!-- 5. Bilateral Stimulation Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBilateral"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnEndZen"
        app:layout_constraintTop_toBottomOf="@id/txtZenSubtitle">

        <TextView
            android:id="@+id/txtBilateralInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Follow the dot with your eyes.\nUse headphones for best effect."
            android:textAlignment="center"
            android:textColor="@color/harmonica_hint"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBilateralDot"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_breathing"
            android:backgroundTint="@color/harmonica_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 6. PMR Container -->
    <LinearLayout
        android:id="@+id/layoutPMR"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnEndZen"
        app:layout_constraintTop_toBottomOf="@id/txtZenSubtitle">

        <TextView
            android:id="@+id/txtPMRStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shoulders"
            android:textColor="@color/harmonica_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPMRAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tense up!"
            android:textColor="@color/harmonica_text"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/progressPMR"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:max="100" />
            
    </LinearLayout>

    <Button
        android:id="@+id/btnEndZen"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
